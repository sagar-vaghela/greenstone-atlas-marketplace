{
  "name": "atlas-marketplace",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @atlas/web",
    "dev:web": "npm run dev --workspace @atlas/web",
    "dev:api": "npm run dev --workspace @atlas/api",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:demo": "node scripts/e2e-demo.mjs",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coverage": "vitest run --coverage",
    "build": "npm run build --workspace @atlas/types && npm run build --workspace @atlas/validation && npm run build --workspace @atlas/config && npm run build --workspace @atlas/api && npm run build --workspace @atlas/web",
    "typecheck": "npm run build --workspace @atlas/types && npm run build --workspace @atlas/validation && npm run build --workspace @atlas/config && npm run typecheck --workspaces"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitest/coverage-v8": "^5.0.2",
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "prettier": "^3.6.2",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.2"
  }
}

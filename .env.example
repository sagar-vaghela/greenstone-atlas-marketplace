# Server configuration. MONGODB_URI is optional for the in-memory demo.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
LOG_LEVEL=info
SLOW_REQUEST_MS=1000
SESSION_TTL_MS=604800000
# Required only when running the explicit legacy currency migration command.
LEGACY_INR_TO_AED_RATE=
PAYMENT_PROVIDER=demo

# Required only for Stripe Test Mode. Keep the first two values server-only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# Server-only secrets and infrastructure. Never expose these as VITE_* values.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=atlas_marketplace

# Frontend-safe configuration only. Vite exposes VITE_* values to the browser.
VITE_API_URL=http://localhost:3000
VITE_STRIPE_PUBLISHABLE_KEY=

# Copy to .env for local development. Never put real credentials in this file.
# Render runtime values belong in the API service Environment settings.

## API
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
LOG_LEVEL=info
SLOW_REQUEST_MS=1000
SESSION_TTL_MS=604800000
PAYMENT_PROVIDER=demo
# Enable predictable demo users/data only for an explicit local or staging demo.
DEMO_SEED_ENABLED=false

# Optional for local development; required in staging and production.
# Create the Atlas database and database user before deploying.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=atlas_marketplace

# Stripe Test Mode only. Keep the API keys on the server, never in VITE_* variables.
STRIPE_SECRET_KEY=sk_test_replace_with_test_secret
STRIPE_WEBHOOK_SECRET=whsec_replace_with_test_webhook_secret

## Frontend (public build-time values)
VITE_API_URL=http://localhost:3000
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_with_test_publishable_key

## E2E
E2E_BASE_URL=http://localhost:4173
E2E_API_URL=http://localhost:3000

# Required only when running the explicit legacy currency migration command.
LEGACY_INR_TO_AED_RATE=

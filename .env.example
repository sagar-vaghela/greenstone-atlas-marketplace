# Atlas Marketplace environment template
# Copy to .env or apps/api/.env for local development and keep real values out of git.
# The application already enforces MongoDB for production-like environments and it must
# not silently fall back to the in-memory repository in staging or production.

## Local development
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
LOG_LEVEL=info
SLOW_REQUEST_MS=1000
SESSION_TTL_MS=604800000
PAYMENT_PROVIDER=demo

# MongoDB Atlas / local dev testing
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=atlas_marketplace

# Stripe Test Mode values. Secret values are server-only and must stay off the browser.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Browser-safe frontend values. These are the only variables intended for Vite.
VITE_API_URL=http://localhost:3000
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# E2E-only configuration. Keep these environment-driven and do not commit real credentials.
E2E_BASE_URL=http://localhost:4173
E2E_API_URL=http://localhost:3000

# Required only when running the explicit legacy currency migration command.
LEGACY_INR_TO_AED_RATE=

## Staging / demo
# Set NODE_ENV=staging and provide a MongoDB Atlas test database URI.
# Keep Stripe in test mode and use the demo environment's public frontend URL.
# NODE_ENV=staging
# HOST=0.0.0.0
# PORT=3000
# CORS_ORIGIN=https://staging.example.com
# PAYMENT_PROVIDER=stripe
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB_NAME=atlas_marketplace
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# VITE_API_URL=https://api.staging.example.com
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

## Production
# Set NODE_ENV=production and deploy only with real production-ready credentials.
# The server must fail fast if MONGODB_URI is missing.
# NODE_ENV=production
# HOST=0.0.0.0
# PORT=3000
# CORS_ORIGIN=https://www.example.com
# PAYMENT_PROVIDER=stripe
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB_NAME=atlas_marketplace
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PUBLISHABLE_KEY=pk_live_...
# VITE_API_URL=https://api.example.com
# VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
